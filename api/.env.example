# Copy this file to api/.env and edit the values. api/.env is git-ignored - never commit it.

# Neo4j user name (the built-in admin user is "neo4j").
NEO4J_USER=neo4j
# Neo4j password - at least 8 characters. Must match the password set with neo4j-admin.
# Both local instances (dev and test) use this same password.
NEO4J_PASSWORD=change-me-please
# Bolt URI of the DEV Neo4j instance (C:\neo4j\dev, default Bolt port 7687).
NEO4J_URI=bolt://localhost:7687
# Fixed "today" as YYYY-MM-DD for deterministic seeds/demos. Empty = real current date.
AS_OF_DATE=
# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Run the nightly recompute scheduler in this process (true/false). Used from Phase 6.
SCHEDULER_ENABLED=true
# Bolt URI of the separate TEST Neo4j instance (C:\neo4j\test, Bolt port 7688). Tests wipe it.
TEST_NEO4J_URI=bolt://localhost:7688
